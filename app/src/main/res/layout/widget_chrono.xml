<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <!-- Centre dial. Tap flips between the seconds dial and the moon. Sized from code (60% of the face). -->
    <ViewFlipper
        android:id="@+id/flip"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:inAnimation="@anim/flip_in"
        android:outAnimation="@anim/flip_out">

        <ImageView
            android:id="@+id/dial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/moon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Moon phase" />

        <ImageView
            android:id="@+id/solar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Solar system" />
    </ViewFlipper>

    <AnalogClock
        android:id="@+id/needle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dial="@drawable/dial_square"
        android:hand_hour="@drawable/hand_none"
        android:hand_minute="@drawable/hand_none"
        android:hand_second="@drawable/needle_chrono" />

    <!-- Spinning pin needle: an indeterminate ProgressBar is animated by the launcher, no app work. -->
    <ProgressBar
        android:id="@+id/pin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:indeterminate="true"
        android:indeterminateOnly="true"
        android:indeterminateDrawable="@drawable/pin_spin"
        android:indeterminateDuration="1000"
        android:indeterminateBehavior="repeat"
        android:interpolator="@android:anim/linear_interpolator"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/glare"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/glare_chrono"
        android:importantForAccessibility="no" />
</FrameLayout>
